# ASP.NET Core migration (ProjectTracker.Web)
# Note: the compiled UI in ProjectTracker.Web/wwwroot IS committed (so `dotnet run` needs no Node);
# only build outputs and the UI's node_modules / intermediate output are ignored.
**/bin/
**/obj/
ProjectTracker.Web/ClientApp/node_modules/
ProjectTracker.Web/ClientApp/.next/
ProjectTracker.Web/ClientApp/out/
ProjectTracker.Web/ClientApp/next-env.d.ts
ProjectTracker.Web/ClientApp/tsconfig.tsbuildinfo
ProjectTracker.Web/appsettings.*.local.json
ProjectTracker.Web/appsettings.Development.json
TestResults/
*.user

