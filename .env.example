# متغيرات البيئة التي يقرؤها النظام (بديل عن تعبئة appsettings.json — المتغير يغلب قيمة الملف).
# النظام لا يقرأ هذا الملف تلقائيًا: اضبط القيم كمتغيرات بيئة على الخادم (IIS / Docker / systemd).
# لا تضع أسرارًا حقيقية في هذا الملف.

# ─── قاعدة البيانات (SQL Server) — إلزامي ───
DB_SERVER=localhost
DB_NAME=ProjectTracker
# فارغان = مصادقة ويندوز
DB_USER=
DB_PASSWORD=
# DB_CONNECTION_STRING=Server=localhost;Database=ProjectTracker;User Id=...;Password=...;Encrypt=False;TrustServerCertificate=True

# ─── الجلسات — إلزامي (32 حرفًا عشوائيًا على الأقل) ───
# لتوليد قيمة: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ─── البريد الإلكتروني (SMTP) — اختياري ───
SMTP_HOST=
SMTP_FALLBACK_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
MAIL_DOMAIN=example.com
MAIL_FROM=no-reply
MAIL_DISPLAY_NAME=منصة متابعة المشاريع

# ─── الإدارات (خيارات «الإدارة المالكة»، مفصولة بفواصل) — اختياري ───
# DEPARTMENTS=الإدارة العامة,الشؤون المالية,تقنية المعلومات

# ─── الإشعارات ───
# عنوان النظام في روابط البريد. فارغ = يؤخذ تلقائيًا من العنوان الذي يفتح به المستخدمون النظام.
APP_BASE_URL=
NOTIFY_SECRET=
NOTIFY_SCHEDULER=true
# NOTIFY_TIMEZONE=Asia/Riyadh
