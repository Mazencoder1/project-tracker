// ═══════════════════════════════════════════════════════════════════════════════
// إعدادات منصة متابعة المشاريع — هذا هو الملف الذي تعدّله على السيرفر.
// • بعد أي تعديل: احفظ ثم أعد تشغيل النظام (في IIS: Recycle للـ Application Pool).
// • متغيرات البيئة على السيرفر (مثل SMTP_HOST أو DB_NAME) تغلب القيم المكتوبة هنا.
// • القيمة الفارغة "" تعني «غير مضبوط».
// ═══════════════════════════════════════════════════════════════════════════════
{
  // ─── قاعدة البيانات ───────────────────────────────────────────────────────────
  "ConnectionStrings": {
    // سلسلة اتصال كاملة بقاعدة SQL Server. إن كتبتها هنا تُهمل كل حقول قسم "Database" بالأسفل.
    // مثال: "Server=SQLSRV01;Database=ProjectTracker;User Id=tracker_user;Password=...;Encrypt=False;TrustServerCertificate=True"
    "Default": ""
  },
  // استعمل هذا القسم بدل السلسلة الكاملة أعلاه (اترك "Default" فارغًا).
  "Database": {
    // اسم خادم قاعدة البيانات أو عنوانه (IP).
    "Server": "localhost",
    // اسم قاعدة البيانات — إلزامي.
    "Name": "",
    // مستخدم SQL وكلمة مروره. اتركهما فارغين للدخول بحساب ويندوز الخاص بالـ Application Pool.
    "User": "",
    "Password": "",
    // اسم النسخة (Instance) إن وُجدت، مثل SQLEXPRESS. وإلا اتركه فارغًا.
    "Instance": "",
    // منفذ SQL إن لم يكن الافتراضي 1433. وإلا اتركه فارغًا.
    "Port": "",
    // "true" = دخول بحساب ويندوز، "false" = دخول بمستخدم SQL. فارغ = يُحدَّد تلقائيًا حسب وجود "User".
    "TrustedConnection": "",
    // تشفير الاتصال بقاعدة البيانات. اتركه false إلا إن طلبه مسؤول قواعد البيانات.
    "Encrypt": false,
    // قبول شهادة خادم SQL دون تحقق. اتركه true في الشبكة الداخلية.
    "TrustServerCertificate": true,
    // غير مستخدم حاليًا — اتركه كما هو.
    "ApplicationName": "Project Tracker MVC"
  },

  // ─── الأمان والجلسات ──────────────────────────────────────────────────────────
  "Security": {
    // مفتاح سري لتوقيع جلسات الدخول — إلزامي، 32 حرفًا على الأقل (حروف وأرقام عشوائية).
    // لا تشاركه مع أحد. تغييره يُخرج كل المستخدمين المسجّلين حاليًا.
    "SessionSecret": "",
    // مدة بقاء المستخدم مسجّلًا بالساعات (من 1 إلى 72).
    "SessionHours": 8,
    // true إذا كان النظام يُفتح عبر https. اتركه false إذا كان يُفتح عبر http فقط (وإلا لن يعمل الدخول).
    "CookieSecure": false
  },

  // ─── الإدارات — خيارات حقل «الإدارة المالكة» في المشاريع ─────────────────────────
  "Departments": {
    // عدّل القائمة بأسماء إدارات جهتك. فارغة = قائمة افتراضية عامة.
    "List": [ "الإدارة العامة", "الشؤون المالية", "الموارد البشرية", "تقنية المعلومات", "الشؤون القانونية", "أخرى" ]
  },

  // ─── الإشعارات التلقائية بالبريد ────────────────────────────────────────────────
  "Notifications": {
    // مفتاح سري (16 حرفًا فأكثر) فقط إن أردت تشغيل دورة الإشعارات من أداة خارجية عبر POST /api/notifications/run.
    // غير مطلوب في الاستعمال العادي — اتركه فارغًا.
    "Secret": "",
    // اتركه فارغًا: عنوان الروابط يُحدَّد تلقائيًا من Application:BaseUrl أدناه أو من العنوان الفعلي للنظام.
    "BaseUrl": "",
    // true = تعمل الرسائل التلقائية: التذكير الأسبوعي، وتنبيه تأخر المشروع. لا تجعله false إلا لإيقافها عمدًا.
    // (رسالة الإسناد ورسالة اكتمال 100% تُرسلان فورًا في كل الأحوال.)
    "SchedulerEnabled": true
  },

  // ─── روابط النظام ─────────────────────────────────────────────────────────────
  "Application": {
    // عنوان النظام في روابط الإيميلات (زر «فتح المشروع»). اتركه فارغًا ليُؤخذ تلقائيًا من العنوان الذي يفتح به الموظفون
    // النظام فعلًا (مثل https://pm.example.com) — لا عنوان ثابت. اكتبه فقط لتثبيت عنوان معيّن، بدون / في آخره،
    // ولا تكتب عنوان السيرفر المحلي (127.0.0.1) لأنه لا يفتح إلا على السيرفر نفسه.
    "BaseUrl": "",
    // مسار فتح مشروع داخل النظام (لزر «فتح المشروع» في الإيميل). لا تغيّره.
    "ProjectPath": "/meeting?project={id}"
  },

  // ─── البريد الإلكتروني ─────────────────────────────────────────────────────────
  "Email": {
    // ── عام ──
    // true = يُرسل البريد. false = يتوقف كل البريد (يُسجَّل كفاشل).
    "Enabled": true,
    // بريد المرسل الذي يظهر للمستلم.
    "FromEmail": "no-reply@example.com",
    // اسم المرسل الذي يظهر للمستلم.
    "FromName": "منصة متابعة المشاريع",
    // نطاق بريد الجهة.
    "Domain": "example.com",

    // ── خادم SMTP ──
    // خادم البريد الأساسي ثم الاحتياطي.
    "Host": "",
    "FallbackHost": "",
    // منفذ SMTP.
    "Port": 25,
    // اتركهما فارغين للدخول بحساب ويندوز الخاص بالسيرفر (الطريقة المعتمدة غالبًا).
    "Username": "",
    "Password": "",
    // تشفير الاتصال (STARTTLS).
    "EnableSsl": true
  },

  // ─── السجلات ─── لا تغيّرها.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // لا تغيّره.
  "AllowedHosts": "*"
}
